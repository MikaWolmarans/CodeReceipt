# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# ── Application ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com
MAX_DAILY_ANALYSES=100
SESSION_TTL_SECONDS=7200
MAX_ZIP_SIZE_MB=25
MAX_GITHUB_REPO_SIZE_MB=15

# ── LLM (OpenRouter / any OpenAI-compatible endpoint) ────────────────────────
# Base URL for the OpenAI-compatible API.
# Default: OpenRouter.  Swap for any other provider that speaks the same protocol.
LLM_BASE_URL=https://openrouter.ai/api/v1

# API key for the provider above.
LLM_API_KEY=your_openrouter_api_key

# Model to use.  Must be available on the chosen provider.
LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct

# Hard cap on tokens returned per individual LLM call.
# Increase carefully — higher values cost more credits per request.
LLM_MAX_TOKENS_PER_REQUEST=4096

# Maximum number of LLM calls allowed for a single analysis run.
# Acts as a credit-spend guard: if a repo needs more calls than this the
# analysis is aborted cleanly rather than silently burning credits.
LLM_MAX_REQUESTS_PER_ANALYSIS=8

# ── GitHub (optional) ─────────────────────────────────────────────────────────
# Personal access token — raises unauthenticated rate limit from 60 to 5 000 req/hr.
# GITHUB_TOKEN=your_github_token

# ── Email / Resend (optional) ─────────────────────────────────────────────────
# Required only if you want "notify me by email" to work.
# RESEND_API_KEY=your_resend_api_key
# FROM_EMAIL=CodeReceipt <noreply@yourdomain.com>
